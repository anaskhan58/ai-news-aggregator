# Copy to .env and fill in.  (.env is git-ignored - never commit it)

# --- LLM ---
# Any OpenAI-compatible API works. Pick one provider:
#   openai      key: https://platform.openai.com/api-keys   default model: gpt-4.1-mini
#   gemini      key: https://aistudio.google.com/apikey     default model: gemini-flash-latest (free tier)
#   groq        key: https://console.groq.com/keys          default model: openai/gpt-oss-20b (free tier)
#   openrouter  key: https://openrouter.ai/settings/keys    default model: openai/gpt-4.1-mini
#   ollama      no key, local                               default model: llama3.2
#   custom      any OpenAI-compatible server: also set LLM_BASE_URL
LLM_PROVIDER=gemini
LLM_API_KEY=
# LLM_MODEL=                   # leave empty for the provider default
# LLM_BASE_URL=                # only for custom (or a non-default Ollama host)

# --- Database ---
# Local Docker Postgres (docker/docker-compose.yml uses the same values)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_news_aggregator
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Set DATABASE_URL to override the above, e.g. Render's *external* URL to work on production,
# or sqlite:///news.db to run without Docker.
# DATABASE_URL=

# --- Email (Gmail + app password: https://myaccount.google.com/apppasswords) ---
MY_EMAIL=
APP_PASSWORD=
# EMAIL_TO=                    # defaults to MY_EMAIL

# --- Optional: Webshare rotating residential proxy if YouTube blocks transcript requests ---
# WEBSHARE_USERNAME=
# WEBSHARE_PASSWORD=

# --- Pipeline ---
LOOKBACK_HOURS=24
TOP_N=10
